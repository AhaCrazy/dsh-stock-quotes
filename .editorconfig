# Editor defaults for dsh-stock-quotes.
# The whole repository is UTF-8 with LF endings and 2-space indentation.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Keep the double-space line breaks used in the READMEs.
trim_trailing_whitespace = false
