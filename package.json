{
  "name": "dsh-stock-quotes",
  "version": "2.0.1",
  "description": "DeepSeek Harness plugin: a neutral, configurable sidebar data panel for A-share / Hong Kong / US quotes and boards, plus a stock_quote tool for the agent.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "stock",
    "quotes",
    "a-share",
    "eastmoney"
  ],
  "license": "MIT",
  "author": "AhaCrazy",
  "type": "module",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AhaCrazy/dsh-stock-quotes.git"
  },
  "homepage": "https://github.com/AhaCrazy/dsh-stock-quotes#readme",
  "bugs": {
    "url": "https://github.com/AhaCrazy/dsh-stock-quotes/issues"
  },
  "icon": "./icon.svg",
  "meta": {
    "title": "数据面板",
    "description": "可配置的自定义数据面板：侧边栏入口、列表定时自动刷新，显示名称可在设置中修改。"
  },
  "scripts": {
    "test": "node tests/meta.test.mjs && node tests/quotes.test.mjs && node tests/render.test.mjs && node tests/client.test.mjs",
    "build:index": "node scripts/build-index.mjs",
    "lint": "eslint client.js quotes.js index.js",
    "pack:check": "npm pack --dry-run"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./quotes": "./quotes.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./data/*.json": "./data/*.json"
  },
  "files": [
    "index.js",
    "quotes.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "data/*.json",
    "scripts/build-index.mjs",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5"
  }
}
